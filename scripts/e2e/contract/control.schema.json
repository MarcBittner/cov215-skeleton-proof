{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-ver.com/schemas/e2e/control.schema.json",
  "title": "control.json: the setup run's control record",
  "description": "Written by e2e-setup.yml prepare into artifact e2e-control; read only by e2e-report.yml and setup's own later passes. Holds the mail field projection (R6, never a raw row, never a key), the run's created users and tenants, the seed-integrity baseline, the limiter budget, and the C11 seeded-escape control (R36, R61). Never put in the bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "setup_run_id", "run_tag", "convex_deployment", "mail", "seed_integrity", "created", "limiter", "seeded_escape"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "setup_run_id": { "$ref": "#/$defs/runId" },
    "run_tag": { "type": "string", "pattern": "^r[1-9][0-9]{0,19}$" },
    "convex_deployment": { "type": "string", "pattern": "^[a-z]+-[a-z]+-[0-9]+$" },
    "mail": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["projection", "adopted_from_setup_run_id", "contained", "contained_at"],
          "properties": {
            "projection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["emailEnabled", "catchAllAddress", "catchAllSource"],
              "properties": {
                "emailEnabled": { "type": "boolean" },
                "catchAllAddress": { "$ref": "#/$defs/email" },
                "catchAllSource": { "enum": ["database", "default"] }
              }
            },
            "adopted_from_setup_run_id": { "anyOf": [{ "$ref": "#/$defs/runId" }, { "type": "null" }] },
            "contained": { "type": "boolean" },
            "contained_at": { "anyOf": [{ "$ref": "#/$defs/datetime" }, { "type": "null" }] }
          }
        }
      ]
    },
    "seed_integrity": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["read_at", "tables"],
          "properties": {
            "read_at": { "$ref": "#/$defs/datetime" },
            "tables": {
              "type": "object",
              "additionalProperties": false,
              "required": ["projects", "contracts", "changeOrders", "rfis"],
              "properties": {
                "projects": { "$ref": "#/$defs/tableDigest" },
                "contracts": { "$ref": "#/$defs/tableDigest" },
                "changeOrders": { "$ref": "#/$defs/tableDigest" },
                "rfis": { "$ref": "#/$defs/tableDigest" }
              }
            }
          }
        }
      ]
    },
    "created": {
      "type": "object",
      "additionalProperties": false,
      "required": ["users", "tenants"],
      "properties": {
        "users": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "email"],
            "properties": {
              "user_id": { "type": "string", "pattern": "^user_[A-Za-z0-9]{20,40}$" },
              "email": { "$ref": "#/$defs/email" }
            }
          }
        },
        "tenants": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["org_id", "test_id", "recipe"],
            "properties": {
              "org_id": { "type": "string", "pattern": "^[a-z0-9]{16,64}$" },
              "test_id": { "$ref": "#/$defs/testId" },
              "recipe": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
            }
          }
        }
      }
    },
    "limiter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_creates_per_s", "ticket_mints_per_s", "max_users", "max_tickets_per_min", "max_tenants", "deadline_at"],
      "properties": {
        "user_creates_per_s": { "type": "number", "minimum": 0 },
        "ticket_mints_per_s": { "type": "number", "minimum": 0 },
        "max_users": { "type": "integer", "minimum": 0, "maximum": 200 },
        "max_tickets_per_min": { "type": "integer", "minimum": 0, "maximum": 60 },
        "max_tenants": { "type": "integer", "minimum": 0, "maximum": 20 },
        "deadline_at": { "$ref": "#/$defs/datetime" }
      }
    },
    "seeded_escape": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["function_id", "break_sha", "branch", "dropped"],
          "properties": {
            "function_id": { "type": "string", "pattern": "^fn:[^\\s:|\\\\/][^\\s:|\\\\]*::[^\\s|]+$" },
            "break_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "branch": { "type": "string", "pattern": "^e2e/fresh/[A-Za-z0-9._-]{1,64}$" },
            "dropped": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/testId" } }
          }
        }
      ]
    }
  },
  "$defs": {
    "runId": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "datetime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "email": { "type": "string", "maxLength": 254, "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$" },
    "tableDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sha256"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "testId": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^(test:[^\\s:|\\\\/][^\\s:|\\\\]*::[^\\r\\n\\t]+|gen:screen:cell:[^\\r\\n\\t]+|gen:snapshot:control:cell:[^\\r\\n\\t]+)$"
    }
  }
}
