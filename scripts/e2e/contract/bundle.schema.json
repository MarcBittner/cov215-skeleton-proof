{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-ver.com/schemas/e2e/bundle.schema.json",
  "title": "Inputs bundle plaintext",
  "description": "The JSON setup encrypts into artifact e2e-bundle (or e2e-bundle-ai) for one dispatch (R72, R81b, R81c, R93). Never written unencrypted to any artifact, input or log. Holds no bypass secret and no app key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "setup_run_id",
    "run_key",
    "run_tag",
    "kind",
    "sha",
    "vercel_deployment_id",
    "base_url",
    "convex_url",
    "select_mode",
    "selection",
    "shard_plan",
    "tenants",
    "tickets",
    "users",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "setup_run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "run_key": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "run_tag": { "type": "string", "pattern": "^r[1-9][0-9]{0,19}$" },
    "kind": { "enum": ["pr", "postmerge", "nightly", "gate", "mut", "fallback", "fresh", "base"] },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "vercel_deployment_id": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{8,64}$" },
    "base_url": { "type": "string", "pattern": "^https://[a-z0-9][a-z0-9.-]*[a-z0-9](/)?$", "maxLength": 253 },
    "convex_url": { "type": "string", "pattern": "^https://[a-z]+-[a-z]+-[0-9]+\\.convex\\.cloud$" },
    "select_mode": { "enum": ["full", "select"] },
    "selection": { "type": ["object", "null"] },
    "shard_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_key", "index", "predicted_ms", "tests"],
        "properties": {
          "run_key": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "index": { "type": "integer", "minimum": 1, "maximum": 16 },
          "predicted_ms": { "type": "integer", "minimum": 0 },
          "tests": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "file", "project", "predicted_ms"],
              "properties": {
                "id": { "$ref": "#/$defs/testId" },
                "kind": { "enum": ["functional", "screen", "snapshot"] },
                "file": { "type": "string", "pattern": "^e2e/[^\\s:|\\\\]+\\.spec\\.ts$", "maxLength": 300 },
                "project": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
                "predicted_ms": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "tenants": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": { "type": "string", "pattern": "^t_[0-9a-f]{24}(#([2-9]|1[0-9]|20))?$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "org_id", "org_name", "recipe", "members"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\r\\n\\t]+$" },
          "org_id": { "$ref": "#/$defs/convexId" },
          "org_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,99}$" },
          "recipe": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "user_id", "convex_user_id", "email", "role"],
              "properties": {
                "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]{0,40}$" },
                "user_id": { "$ref": "#/$defs/clerkUserId" },
                "convex_user_id": { "$ref": "#/$defs/convexId" },
                "email": { "$ref": "#/$defs/email" },
                "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$" }
              }
            }
          }
        }
      }
    },
    "tickets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "type": "string", "pattern": "^([1-9]|1[0-6])$" },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": { "$ref": "#/$defs/email" },
        "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._-]{16,4096}$" }
      }
    },
    "users": {
      "type": "object",
      "maxProperties": 250,
      "propertyNames": { "$ref": "#/$defs/clerkUserId" },
      "additionalProperties": { "$ref": "#/$defs/email" }
    },
    "issued_at": { "$ref": "#/$defs/datetime" },
    "expires_at": { "$ref": "#/$defs/datetime" }
  },
  "$defs": {
    "datetime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$" },
    "convexId": { "type": "string", "pattern": "^[a-z0-9]{16,64}$" },
    "clerkUserId": { "type": "string", "pattern": "^user_[A-Za-z0-9]{20,40}$" },
    "email": { "type": "string", "maxLength": 254, "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$" },
    "testId": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^(test:[^\\s:|\\\\/][^\\s:|\\\\]*::[^\\r\\n\\t]+|gen:screen:cell:[^\\r\\n\\t]+|gen:snapshot:control:cell:[^\\r\\n\\t]+)$"
    }
  }
}
