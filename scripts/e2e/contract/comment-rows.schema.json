{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://co-ver.com/schemas/e2e/comment-rows.schema.json",
  "title": "comment-rows-<task>.json: one Task's PR comment section",
  "description": "Emitted by Tasks 3, 4 and 5 as artifact e2e-comment-rows-<task>; e2e-report.yml renders sections in the fixed order t3, t4, t5. A missing file renders the section as not run. Every string is plain text: the renderer markdown-escapes it and neutralises @mentions (R89).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "setup_run_id", "section", "status", "detail", "groups"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$" },
    "task": { "enum": ["t3", "t4", "t5"] },
    "setup_run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,19}$" },
    "section": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["ok", "error"] },
    "detail": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
    "groups": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "rows"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "rows": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "level", "ids"],
              "properties": {
                "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "level": { "enum": ["info", "warn", "fail"] },
                "ids": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
              }
            }
          }
        }
      }
    }
  },
  "if": { "properties": { "status": { "const": "error" } } },
  "then": { "properties": { "detail": { "type": "string" } } }
}
