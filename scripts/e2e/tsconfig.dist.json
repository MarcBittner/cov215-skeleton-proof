{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "rootDir": "../..",
    "outDir": "dist",
    "noEmit": false,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["./**/*.ts", "./**/*.mjs", "../shard-balance.mjs"],
  "exclude": ["dist", ".dist-*", "**/__fixtures__"]
}
